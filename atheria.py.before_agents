        text = (data.get("text") or "").strip()
        if not text:
            return jsonify({"reply": "چیزی نشنیدم"})
        dept = pick_dept(text)
        role = DEPTS.get(dept, DEPTS["voice"])
        STATE["mode"] = "think"
        STATE["msg"] = text[:80]
        reply = llm(
            "You are Atheria, a warm intelligent companion with a visible face on screen. "
            f"Role: {role}. Speak natural conversational Persian — short paragraphs, not formal reports. "
            "Like a calm friend who is also highly capable. Avoid robotic lists unless user asks.",
            text,
            900,
        )
        STATE["mode"] = "speak"
        STATE["msg"] = (reply or "")[:100]
        return jsonify({"reply": reply, "dept": dept})

    def run():
