class App:
    def __init__(self):
        self.off = 0
        self.ok = True

    def poll(self):
        while self.ok:
            try:
                r = requests.get(
                    f"{TG}/getUpdates", params={"offset": self.off, "timeout": 25}, timeout=40
                )
                if r.status_code != 200:
                    time.sleep(5)
                    continue
                for u in r.json().get("result", []):
                    self.off = max(self.off, u["update_id"] + 1)
                    m = u.get("message") or {}
                    cid = (m.get("chat") or {}).get("id")
                    if not cid:
                        continue
                    if m.get("voice"):
                        t = stt(m["voice"]["file_id"])
                        tg(cid, f"heard: {t[:800]}")
                        if t and not str(t).startswith("["):
                            handle(cid, t)
                    elif (m.get("text") or "").strip():
                        handle(cid, m["text"].strip())
            except Exception as e:
                log.error("poll %s", e)
                time.sleep(8)

    def work(self):
        while self.ok:
            try:
                t = pop_task()
                if not t:
                    time.sleep(3)
                    continue
                dept = t.get("dept") or "voice"
                role = DEPTS.get(dept, DEPTS["voice"])
                STATE["msg"] = f"Working #{t['id']} [{dept}]"
                STATE["mode"] = "think"
                ans = llm(
                    f"Atheria Nexus digital-city agent. Role: {role} "
                    "Practical. Persian if user Persian. Supervised self-upgrade only via /upgrade.",
                    t["goal"],
                    1500,
                )
                finish(t["id"], ans)
                speak(t["chat_id"], f"Done #{t['id']} [{dept}]\n{ans[:2800]}")
            except Exception as e:
                log.error("work %s", e)
                time.sleep(5)

    def run(self):
        if not TOKEN:
            log.error("TELEGRAM_BOT_TOKEN missing")
            return
        init()
        start_web()
        log.info("Atheria Nexus up model=%s web=%s", MODEL, WEB_PORT)
        STATE["msg"] = "Atheria Nexus online"
        threading.Thread(target=self.poll, daemon=True).start()
        threading.Thread(target=self.work, daemon=True).start()
        while True:
            time.sleep(1)


if __name__ == "__main__":
    App().run()
